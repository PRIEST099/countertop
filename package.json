{
  "name": "countertop",
  "version": "0.1.0",
  "description": "An open-source, voice-first smart-display simulator for testing MCP servers and MCP Apps the way Alexa+ uses them — account linking, Echo Show-sized screens, latency budgets and readiness checks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "dev": "vite build && tsx watch --ignore web server/index.ts",
    "typecheck": "tsc --noEmit",
    "walkthrough": "tsx scripts/walkthrough.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1154.0",
    "@aws-sdk/client-polly": "^3.1154.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "puppeteer-core": "^25.15.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
